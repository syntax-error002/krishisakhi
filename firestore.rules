rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles - only accessible by the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Community collections - anyone can read, only authenticated users can write
    match /mentors/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gov_schemes/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /market_listings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /mandi_prices/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
