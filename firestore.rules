rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles - only accessible by the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Community collections - anyone can read, only authenticated users can write
    match /mentors/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gov_schemes/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /market_listings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /mandi_prices/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // New collections for the added features
    match /expert_bookings/{bookingId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.admin == true);
    }

    match /mentorship_schedules/{scheduleId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (request.auth.uid == resource.data.farmerId || request.auth.token.admin == true);
    }

    match /buy_requests/{requestId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.buyerId || request.auth.token.admin == true);
    }

    match /farming_tasks/{taskId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.admin == true);
    }
  }
}
